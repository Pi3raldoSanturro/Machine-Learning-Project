Creiamo un DataFrame con le recensioni e le etichette. La cella che segue crea un DataFrame con due colonne:

* text = recensione
* label = 0,1
import zipfile
import pandas as pd
from io import TextIOWrapper

zip_path = "/content/drive/MyDrive/MLProject/AmazonFashionBinary.zip"

def load_reviews_from_zip(zip_path):
    texts, labels = [], []

    with zipfile.ZipFile(zip_path, 'r') as zip_ref:   # apertura file zip
        for file_name in zip_ref.namelist():
            if file_name.startswith("AmazonFashionBinary/0/"):
                label = 0  # review negative
            elif file_name.startswith("AmazonFashionBinary/1/"):
                label = 1  # review positive
            else:
                continue


            with zip_ref.open(file_name) as f:
                text = TextIOWrapper(f, encoding="utf-8").read().strip()
                texts.append(text)
                labels.append(label)

    return pd.DataFrame({"text": texts, "label": labels})

# Caricamento dataset
df = load_reviews_from_zip(zip_path)

print("Numero totale di recensioni nel dataset:", len(df))


